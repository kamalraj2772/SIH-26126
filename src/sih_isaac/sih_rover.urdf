<robot name="sih_rover">
  <!-- ============================================================
       SIH26126 skid-steer UGV
       - wheelbase 0.80 m, track 0.70 m, wheel radius 0.15 m
       - mass 60 kg, max speed 1.5 m/s
       - single xacro source: feeds robot_state_publisher AND the
         Gazebo Harmonic spawn (gz sim converts URDF->SDF, carrying
         <gazebo> plugin/sensor blocks through unchanged)
       ============================================================ -->
  <material name="chassis_grey">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="sensor_orange">
    <color rgba="0.9 0.45 0.05 1.0"/>
  </material>
  <!-- ================= base_link / chassis ================= -->
  <link name="base_link">
    <inertial>
      <mass value="60.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1.5625" ixy="0" ixz="0" iyy="2.7625" iyz="0" izz="3.7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.7 0.5 0.25"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.7 0.5 0.25"/>
      </geometry>
    </collision>
  </link>
  <link name="wheel_fl_link">
    <inertial>
      <mass value="3.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.018475" ixy="0" ixz="0" iyy="0.018475" iyz="0" izz="0.033749999999999995"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.15"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.15"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl_link"/>
    <origin rpy="0 0 0" xyz="0.4 0.35 -0.10500000000000001"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="wheel_fl_link">
    <mu1>0.55</mu1>
    <mu2>0.55</mu2>
  </gazebo>
  <link name="wheel_fr_link">
    <inertial>
      <mass value="3.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.018475" ixy="0" ixz="0" iyy="0.018475" iyz="0" izz="0.033749999999999995"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.15"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.15"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr_link"/>
    <origin rpy="0 0 0" xyz="0.4 -0.35 -0.10500000000000001"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="wheel_fr_link">
    <mu1>0.55</mu1>
    <mu2>0.55</mu2>
  </gazebo>
  <link name="wheel_rl_link">
    <inertial>
      <mass value="3.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.018475" ixy="0" ixz="0" iyy="0.018475" iyz="0" izz="0.033749999999999995"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.15"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.15"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl_link"/>
    <origin rpy="0 0 0" xyz="-0.4 0.35 -0.10500000000000001"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="wheel_rl_link">
    <mu1>0.55</mu1>
    <mu2>0.55</mu2>
  </gazebo>
  <link name="wheel_rr_link">
    <inertial>
      <mass value="3.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.018475" ixy="0" ixz="0" iyy="0.018475" iyz="0" izz="0.033749999999999995"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.15"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.15"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr_link"/>
    <origin rpy="0 0 0" xyz="-0.4 -0.35 -0.10500000000000001"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="wheel_rr_link">
    <mu1>0.55</mu1>
    <mu2>0.55</mu2>
  </gazebo>
  <!-- ================= IMU ================= -->
  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.105"/>
  </joint>
  <!-- ================= camera: body-frame mount + REP-103 optical frame =================
       camera_link follows the body convention (x fwd, y left, z up), matching where the
       sensor is physically mounted. camera_optical_frame is a separate child link related
       by a static joint so RTAB-Map (which needs REP-103: z fwd, x right, y down) gets a
       correctly rotated frame_id, verified by inspecting the published image topic's
       frame_id at runtime rather than assuming this transform is right. -->
  <link name="camera_link">
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.03 0.09 0.025"/>
      </geometry>
      <material name="sensor_orange"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0.37 0 0.125"/>
  </joint>
  <link name="camera_optical_frame">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <!-- body (x fwd,y left,z up) -> optical (z fwd,x right,y down) -->
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ================= ground-truth-only sibling link =================
       base_link_gt is a massless link welded to base_link purely so
       PosePublisher can report an evaluation-only ground truth pose.
       It must never be read by any node in the navigation stack. -->
  <link name="base_link_gt">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="base_link_gt_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_gt"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ============================================================
       Gazebo Harmonic (gz-sim 8) systems and sensors.
       Passed through unchanged by sdformat's URDF->SDF conversion
       when gz sim spawns this same xacro-generated URDF.

       TF ownership honoured here (see project frame table):
         - DiffDrive: cmd_vel -> wheel joints only. Its own odom/tf
           gz-transport topics are redirected to *_gz_debug names and
           are never bridged into ROS: the EKF (Phase 2) is the sole
           owner of odom -> base_link.
         - JointStatePublisher: publishes joint_states only, no TF.
         - PosePublisher: ground-truth only, on a dedicated topic
           bridged to /tf_gt (never /tf): evaluation-only, never
           read by the navigation stack.
       ============================================================ -->
  <!-- Without this, sdformat's URDF->SDF converter lumps every fixed-joint
       child link into base_link by default (confirmed empirically: gz sdf -p
       on this file previously showed camera_link, camera_optical_frame,
       imu_link and base_link_gt all disappearing into a single merged
       base_link, which broke the sensor frame_id, see Rule 2). Each of
       these links must survive as its own SDF link so sensor/pose frame_id
       strings resolve to a frame that actually exists in robot_state_publisher's
       /tf tree. -->
  <gazebo reference="camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="camera_optical_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="imu_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="base_link_gt_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_fl_joint</left_joint>
      <left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint>
      <right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>0.7</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>1.5</max_linear_velocity>
      <min_linear_velocity>-1.5</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <!-- debug-only gz-transport outputs; deliberately not bridged to ROS -->
      <odom_topic>diff_drive/odom_gz_debug</odom_topic>
      <tf_topic>diff_drive/tf_gz_debug</tf_topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_model_pose>false</publish_model_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <update_frequency>30</update_frequency>
      <topic>pose_gt</topic>
    </plugin>
  </gazebo>
  <!-- ================= IMU: 200 Hz, realistic MEMS noise =================
       Values approximate a low-cost consumer MEMS IMU (e.g. ICM-20649 class):
       gyro noise density, accel noise density, and slow bias random walk. -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>200</update_rate>
      <topic>imu/data</topic>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0018</stddev>
              <bias_mean>0.0005</bias_mean>
              <bias_stddev>0.0003</bias_stddev>
              <dynamic_bias_stddev>0.0000075</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>500</dynamic_bias_correlation_time>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0018</stddev>
              <bias_mean>-0.0004</bias_mean>
              <bias_stddev>0.0003</bias_stddev>
              <dynamic_bias_stddev>0.0000075</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>500</dynamic_bias_correlation_time>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0018</stddev>
              <bias_mean>0.0002</bias_mean>
              <bias_stddev>0.0003</bias_stddev>
              <dynamic_bias_stddev>0.0000075</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>500</dynamic_bias_correlation_time>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
              <bias_mean>0.02</bias_mean>
              <bias_stddev>0.01</bias_stddev>
              <dynamic_bias_stddev>0.0003</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>500</dynamic_bias_correlation_time>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
              <bias_mean>-0.015</bias_mean>
              <bias_stddev>0.01</bias_stddev>
              <dynamic_bias_stddev>0.0003</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>500</dynamic_bias_correlation_time>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
              <bias_mean>0.01</bias_mean>
              <bias_stddev>0.01</bias_stddev>
              <dynamic_bias_stddev>0.0003</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>500</dynamic_bias_correlation_time>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <!-- ================= RGB-D camera =================
       ZED-class: on-device depth, 1280x720, 90 deg HFOV, 30 Hz.

       Mounted on camera_link, NOT camera_optical_frame: a Gazebo camera
       sensor renders along its own frame's +x axis, whereas a REP-103
       optical frame has +z forward. Mounting on the optical frame made the
       camera physically look 90 deg to the right (verified: it rendered its
       own wheel). camera_link uses the body convention (+x forward), which
       is what Gazebo wants. The REP-103 frame_id that RTAB-Map needs is
       applied at the bridge (config/bridge.yaml frame_id override) and
       published as a real TF frame by robot_state_publisher. -->
  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>camera</topic>
      <camera>
        <horizontal_fov>1.5707963267948966</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>50.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>20.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
</robot>
