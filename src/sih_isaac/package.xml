<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sih_isaac</name>
  <version>0.1.0</version>
  <description>
    SIH26126 GPS-denied UGV navigation in Isaac Sim 6.0: world generation from
    a UTM-44N GeoTIFF prior, ROS 2 bridge runtime, Nav2 (Smac global + MPPI
    local), GPS-free localization, and UTM goal input. Simulation only.
  </description>
  <maintainer email="rig@kct.ac.in">RIG KCT</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
